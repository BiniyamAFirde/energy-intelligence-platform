# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=energy_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://energy_user:change_me@db:5432/energy_platform

# --- Auth (JWT on write/admin endpoints only, per Phase 1 decision) ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (frontend dev server) ---
CORS_ORIGINS=http://localhost:5173

# --- Backend service ---
BACKEND_PORT=8000

# --- Frontend service ---
FRONTEND_PORT=5173

# --- Render deployment only (see docs/deployment_render.md) ---
# Not needed for local Docker Compose: models/random_forest_v1.joblib is
# already present via the host bind mount. On Render, there is no host
# filesystem to mount, so backend/docker_model_fetch.py downloads it from
# a GitHub Release asset at container start instead. Leave unset locally.
# MODEL_ARTIFACT_URL=https://github.com/BiniyamAFirde/energy-intelligence-platform/releases/download/model-v1/random_forest_v1.joblib
# MODEL_ARTIFACT_SHA256=2b859538307206b4516ff23c984878b1051a05cc910480ec9bdcd27ee83421a8
# Render also injects PORT itself -- do not set it manually.
